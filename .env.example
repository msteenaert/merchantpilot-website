# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp number in international format, digits only, e.g. 31612345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the site, e.g. https://merchantpilot.nl
NEXT_PUBLIC_SITE_URL=
